generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ImageType {
  THUMBNAIL
  LARGE
  PROFILE
  ICON
}

// Arrangementstyper – udvid med flere (fx EVENT, WORKSHOP) ved behov
enum ArrangementType {
  TASTING // smagning
}

model Image {
  id         String            @id @default(uuid())
  url        String
  type       ImageType
  width      Int? // billedbredde (px)
  height     Int? // billedhøjde (px)
  userId     String?
  beverageId String?
  categoryId String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  beverage   Beverage?         @relation(fields: [beverageId], references: [id], onDelete: Cascade)
  category   BeverageCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([beverageId])
  @@index([categoryId])
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  email              String              @unique
  passwordHash       String
  createdAt          DateTime            @default(now())
  images             Image[]
  reviews            Review[]
  createdArrangements Arrangement[]
}

model BeverageCategory {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  images               Image[]
  attributeDefinitions AttributeDefinition[]
  types                BeverageType[]
  questions            Question[]
  brands               Brand[]
}

model BeverageType {
  id                   String                @id @default(uuid())
  categoryId           String
  name                 String
  description          String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  attributeDefinitions AttributeDefinition[]
  beverages            Beverage[]
  category             BeverageCategory      @relation(fields: [categoryId], references: [id])
  questions            Question[]

  @@index([categoryId])
}

model Brand {
  id          String             @id @default(uuid())
  name        String
  description String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  beverages   Beverage[]
  categories  BeverageCategory[]
}

model Beverage {
  id              String                   @id @default(uuid())
  beverageTypeId  String
  brandId         String
  name            String
  country         String
  metadata        Json?
  averageRating   Float                    @default(0)
  reviewCount     Int                      @default(0)
  images          Image[]
  createdAt       DateTime                 @default(now())
  type            BeverageType             @relation(fields: [beverageTypeId], references: [id])
  brand           Brand                    @relation(fields: [brandId], references: [id])
  attributeValues     BeverageAttributeValue[]
  reviews             Review[]
  arrangementBeverages ArrangementBeverage[]

  @@unique([brandId, name])
  @@index([beverageTypeId])
  @@index([brandId])
}

model BeverageAttributeValue {
  id           String              @id @default(uuid())
  beverageId   String
  attributeId  String
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id])
  beverage     Beverage            @relation(fields: [beverageId], references: [id])

  @@unique([beverageId, attributeId])
  @@index([beverageId])
  @@index([attributeId])
}

model AttributeDefinition {
  id              String                   @id @default(uuid())
  attributeKey    String                   @unique
  displayName     String
  dataType        String
  filterable      Boolean                  @default(false)
  required        Boolean                  @default(false)
  validationRules Json?
  options         Json?
  sortOrder       Int?
  categories      BeverageCategory[]
  types           BeverageType[]
  attributeValues BeverageAttributeValue[]
}

model Question {
  id            String           @id @default(uuid())
  categoryId    String
  typeId        String?
  questionText  String
  answerType    String
  options       Json?
  sortOrder     Int?
  required      Boolean          @default(false)
  category      BeverageCategory @relation(fields: [categoryId], references: [id])
  type          BeverageType?    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  reviewAnswers ReviewAnswer[]

  @@index([categoryId])
  @@index([typeId])
}

model Review {
  id          String         @id @default(uuid())
  userId      String
  beverageId  String
  rating      Float
  title       String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  beverage    Beverage       @relation(fields: [beverageId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  answers     ReviewAnswer[]

  @@unique([userId, beverageId])
  @@index([userId])
  @@index([beverageId])
}

model ReviewAnswer {
  id         String   @id @default(uuid())
  reviewId   String
  questionId String
  answer     String
  question   Question @relation(fields: [questionId], references: [id])
  review     Review   @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, questionId])
  @@index([reviewId])
  @@index([questionId])
}

// --- Arrangementer (smagninger m.m.) – dynamisk struktur for flere typer senere ---
// Et arrangement er en række drikkevarer (med angivet rækkefølge); brugerne anmelder dem via almindelige Review.
// Har brugeren allerede anmeldt en drikkevare, kan de springe over eller lave review forfra.

model Arrangement {
  id          String                 @id @default(uuid())
  type        ArrangementType
  name        String
  description String?
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  beverages   ArrangementBeverage[]

  @@index([createdById])
  @@index([type])
}

// Drikkevarer på arrangementet med rækkefølge (sortOrder: 0, 1, 2, …)
model ArrangementBeverage {
  id            String      @id @default(uuid())
  arrangementId String
  beverageId    String
  sortOrder     Int         @default(0)
  arrangement   Arrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  beverage      Beverage    @relation(fields: [beverageId], references: [id], onDelete: Cascade)

  @@unique([arrangementId, beverageId])
  @@index([arrangementId])
  @@index([beverageId])
}

// Uploads that got a presigned URL but were never "claimed" by creating a Beverage/User/Category/Type.
// Cleanup job deletes these from S3 and removes the rows.
model PendingUpload {
  id        String   @id @default(uuid())
  bucket    String   @default("maanslogen-dev") // S3 bucket name (allows multiple buckets)
  key       String // S3 object key, e.g. images/uuid
  expiresAt DateTime

  @@unique([bucket, key])
  @@index([expiresAt])
}
