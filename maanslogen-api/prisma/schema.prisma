generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ImageType {
  THUMBNAIL
  LARGE
  PROFILE
  ICON
}

model Image {
  id           String            @id @default(uuid())
  url          String
  type         ImageType
  userId       String?
  beverageId   String?
  categoryId   String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  beverage     Beverage?         @relation(fields: [beverageId], references: [id], onDelete: Cascade)
  category     BeverageCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([beverageId])
  @@index([categoryId])
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())
  images         Image[]
  reviews        Review[]
}

model BeverageCategory {
  id          String                @id @default(uuid())
  name        String
  description String?
  images      Image[]
  attributes  AttributeDefinition[]
  types       BeverageType[]
  questions   Question[]
}

model BeverageType {
  id          String                @id @default(uuid())
  categoryId  String
  name        String
  description String?
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  attributes  AttributeDefinition[]
  beverages   Beverage[]
  category    BeverageCategory      @relation(fields: [categoryId], references: [id])
  questions   Question[]

  @@index([categoryId])
}

model Beverage {
  id              String                   @id @default(uuid())
  beverageTypeId  String
  brand           String
  name            String
  country         String
  metadata        Json?
  averageRating   Float                    @default(0)
  reviewCount     Int                      @default(0)
  images          Image[]
  createdAt       DateTime                 @default(now())
  type            BeverageType             @relation(fields: [beverageTypeId], references: [id])
  attributeValues BeverageAttributeValue[]
  reviews         Review[]

  @@unique([brand, name])
  @@index([beverageTypeId])
}

model BeverageAttributeValue {
  id           String              @id @default(uuid())
  beverageId   String
  attributeId  String
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id])
  beverage     Beverage            @relation(fields: [beverageId], references: [id])

  @@unique([beverageId, attributeId])
  @@index([beverageId])
  @@index([attributeId])
}

model AttributeDefinition {
  id              String                   @id @default(uuid())
  categoryId      String
  typeId          String?
  attributeKey    String
  displayName     String
  dataType        String
  filterable      Boolean                  @default(false)
  required        Boolean                  @default(false)
  validationRules Json?
  options         Json?
  sortOrder       Int?
  category        BeverageCategory         @relation(fields: [categoryId], references: [id])
  type            BeverageType?            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  attributeValues BeverageAttributeValue[]

  @@unique([categoryId, typeId, attributeKey])
  @@index([categoryId])
  @@index([typeId])
}

model Question {
  id            String           @id @default(uuid())
  categoryId    String
  typeId        String?
  questionText  String
  answerType    String
  options       Json?
  sortOrder     Int?
  required      Boolean          @default(false)
  category      BeverageCategory @relation(fields: [categoryId], references: [id])
  type          BeverageType?    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  reviewAnswers ReviewAnswer[]

  @@index([categoryId])
  @@index([typeId])
}

model Review {
  id          String         @id @default(uuid())
  userId      String
  beverageId  String
  rating      Float
  title       String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  beverage    Beverage       @relation(fields: [beverageId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  answers     ReviewAnswer[]

  @@unique([userId, beverageId])
  @@index([userId])
  @@index([beverageId])
}

model ReviewAnswer {
  id         String   @id @default(uuid())
  reviewId   String
  questionId String
  answer     String
  question   Question @relation(fields: [questionId], references: [id])
  review     Review   @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, questionId])
  @@index([reviewId])
  @@index([questionId])
}

// Uploads that got a presigned URL but were never "claimed" by creating a Beverage/User/Category/Type.
// Cleanup job deletes these from S3 and removes the rows.
model PendingUpload {
  id        String   @id @default(uuid())
  bucket   String   @default("maanslogen-test") // S3 bucket name (allows multiple buckets)
  key       String   // S3 object key, e.g. images/uuid
  expiresAt DateTime

  @@unique([bucket, key])
  @@index([expiresAt])
}
